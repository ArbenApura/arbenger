{
	"name": "arbenger",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 8000",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"deploy": "vite build && wrangler pages deploy .svelte-kit/cloudflare --project-name arbenger --branch main",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"type": "module",
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"jszip": "^3.10.1",
		"lucide-svelte": "^1.0.1",
		"nanoid": "^5.1.11",
		"postgres": "^3.4.9",
		"svelte": "^4.2.20",
		"svelte-sonner": "^0.3.28",
		"tailwind-merge": "^3.5.0",
		"tippy.js": "^6.3.7",
		"typescript": "^5.9.3",
		"upng-js": "^2.1.0",
		"vite": "^5.4.21"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^25.6.2",
		"@types/upng-js": "^2.1.5",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.2.4",
		"tslib": "^2.8.1",
		"wrangler": "^4.90.0"
	}
}
